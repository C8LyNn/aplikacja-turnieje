{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "migrate:tournament-stages:preflight": "node ./scripts/preflight-tournament-stages-v1.mjs",
    "migrate:tournament-stages": "node ./scripts/migrate-tournament-stages-v1.mjs",
    "migrate:tournament-stages:development:preflight": "node ./scripts/preflight-development-tournament-stages-v1.mjs",
    "migrate:tournament-stages:development": "node ./scripts/migrate-development-tournament-stages-v1.mjs",
    "migrate:flexible-group-stages:preflight": "node ./scripts/preflight-flexible-group-stages-v2.mjs",
    "migrate:flexible-group-stages": "node ./scripts/migrate-flexible-group-stages-v2.mjs",
    "migrate:flexible-group-stages:development:preflight": "node ./scripts/preflight-development-flexible-group-stages-v2.mjs",
    "migrate:flexible-group-stages:development": "node ./scripts/migrate-development-flexible-group-stages-v2.mjs",
    "test:flexible-group-stages-deployment": "node --test ./test/flexible-group-stages-v2-deployment.test.mjs",
    "reset:series-v1:preflight": "node ./scripts/preflight-series-v1-reset.mjs",
    "reset:series-v1:destructive": "node ./scripts/destructive-series-v1-reset.mjs",
    "reset:series-v1:development:preflight": "node ./scripts/preflight-development-series-v1-reset.mjs",
    "reset:series-v1:development": "node ./scripts/destructive-development-series-v1-reset.mjs",
    "test:reset-safety": "node --test --test-concurrency=1 ./test/development-reset-config.test.mjs ./test/reset-safety.integration.test.mjs",
    "migrate:configurable-seeding:preflight": "node ./scripts/preflight-configurable-seeding-v2.mjs",
    "migrate:configurable-seeding": "node ./scripts/migrate-configurable-seeding-v2.mjs",
    "migrate:configurable-seeding:development:preflight": "node ./scripts/preflight-development-configurable-seeding-v2.mjs",
    "migrate:configurable-seeding:development": "node ./scripts/migrate-development-configurable-seeding-v2.mjs",
    "test:configurable-seeding-deployment": "node --test ./test/configurable-seeding-v2-deployment.test.mjs",
    "schema:compare:pre-republish": "node ./scripts/compare-replit-schema-catalogs.mjs",
    "test:schema-catalog-comparison": "node --test ./test/schema-catalog-comparison.test.mjs",
    "test:schema-catalog-comparison:integration": "node --test --test-concurrency=1 ./test/schema-catalog-comparison.integration.test.mjs",
    "preflight:tournament-engine-v2": "node ./scripts/preflight-tournament-engine-v2.mjs",
    "test:tournament-engine-v2-preflight": "node --test --test-concurrency=1 ./test/tournament-engine-v2-preflight.integration.test.mjs",
    "migrate:tournament-routing-persistence:preflight": "node ./scripts/preflight-tournament-routing-persistence-v2.mjs",
    "test:tournament-routing-persistence-deployment": "node --test ./test/tournament-routing-persistence-v2-deployment.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.20.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
