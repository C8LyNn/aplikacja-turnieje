<Project Sdk="Microsoft.NET.Sdk">
  <!-- A82 isolated W9 mechanics regression project: zero production source edits. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Assets/CoreClash/Data/*.cs" />
    <Compile Include="../../Assets/CoreClash/Core/**/*.cs" />
    <Compile Include="../../Assets/CoreClash/Physics/*.cs" />
    <Compile Include="../../Assets/CoreClash/Networking/*.cs" Exclude="../../Assets/CoreClash/Networking/Ngo*.cs" />
    <!-- The production wire codec is managed-only even though its name starts with Ngo. -->
    <Compile Include="../../Assets/CoreClash/Networking/NgoWireProtocol.cs" />
    <Compile Include="../../Assets/CoreClash/Input/LaunchGesture.cs" />
    <Compile Include="../../Assets/CoreClash/Presentation/MatchLayout.cs" />
    <Compile Include="../../Assets/CoreClash/Presentation/BallSelection.cs" />
    <Compile Include="../../Assets/CoreClash/Presentation/AimGuide.cs" />
    <Compile Include="../../Assets/CoreClash/Presentation/FeedbackTimeline.cs" />
    <Compile Include="../../Assets/CoreClash/Presentation/BallIdentity.cs" />
    <Compile Include="../../Assets/CoreClash/Presentation/BallInspection.cs" />
    <Compile Include="../../Assets/CoreClash/Presentation/SetupLayout.cs" />
    <Compile Include="../../Assets/CoreClash/Presentation/DeviceViewport.cs" />
    <Compile Include="../../Assets/CoreClash/Input/PrimaryPointer.cs" />
  </ItemGroup>
</Project>
