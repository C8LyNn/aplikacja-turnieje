{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:deadlock-game-catalog": "node --import tsx --test ./test/deadlock-game-catalog.test.ts",
    "test:marvel": "node --import tsx --test ./test/marvel-game-config.test.ts ./test/marvel-elimination-groups.test.ts",
    "test:marvel:integration": "node --import tsx --test --test-concurrency=1 ./test/marvel-elimination-stage.integration.test.ts",
    "test:deadlock-game-config:integration": "node --import tsx --test --test-concurrency=1 ./test/deadlock-game-config.integration.test.ts",
    "test:double-elimination": "node --import tsx --test ./test/double-elimination-v2.test.ts && node --import tsx --test --test-concurrency=1 ./test/double-elimination-persistence.integration.test.ts ./test/double-elimination-api.integration.test.ts",
    "test:unit": "node --import tsx ./test/run-tests.ts unit && node --import tsx --test ../tournament-manager/src/lib/backup-file.test.ts ../tournament-manager/src/lib/stage-utils.test.ts ../tournament-manager/src/lib/tournament-query-invalidation.test.ts && tsx --tsconfig ../tournament-manager/tsconfig.json --import ../tournament-manager/test/setup-dom.mjs --test ../tournament-manager/src/lib/tournament-stages-ui.test.tsx ../tournament-manager/src/lib/seeding-ceremony-view.test.ts",
    "test:integration": "node --import tsx ./test/run-tests.ts integration",
    "legacy-credentials:preflight": "tsx ./src/scripts/preflight-legacy-credentials.ts",
    "legacy-credentials:recover-organizer": "tsx ./src/scripts/recover-legacy-organizer.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/game-catalog": "workspace:*",
    "@workspace/stage-basket-flow": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
