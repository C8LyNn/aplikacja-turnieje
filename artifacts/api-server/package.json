{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "node --import tsx --test ./test/series-result.test.ts ./test/standings.test.ts ./test/round-robin.test.ts ./test/swiss.test.ts ./test/tournament-stage-plan.test.ts ./test/group-stage.test.ts ./test/seeding.test.ts ./test/seeding-ceremony.test.ts ./test/stage-placement.test.ts ./test/tournament-blueprint-v2.test.ts ./test/stage-ranking.test.ts ./test/group-playoff.test.ts ./test/deployment-safety.test.ts ./test/deployment-task.test.ts ./test/tournament-stages-deployment.test.ts ./test/auth-config.test.ts ./test/health.test.ts ../tournament-manager/src/lib/backup-file.test.ts ../tournament-manager/src/lib/stage-utils.test.ts && tsx --tsconfig ../tournament-manager/tsconfig.json --test ../tournament-manager/src/lib/tournament-stages-ui.test.tsx ../tournament-manager/src/lib/seeding-ceremony-view.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 ./test/access.integration.test.ts ./test/complete-match.integration.test.ts ./test/revert-match.integration.test.ts ./test/series-v1.integration.test.ts ./test/tournament-stages-schema.integration.test.ts ./test/tournament-stages-group-stage.integration.test.ts ./test/migration.integration.test.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.0",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
